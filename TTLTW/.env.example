# Copy to .env and fill values. .env is gitignored.

# Facebook OAuth (Meta for Developers → My Apps → App Settings)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/WebDynamic_war/login-facebook-callback

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/WebDynamic_war/login-google-callback
